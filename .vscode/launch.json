{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1 · Generate dataset  (~15s)",
      "type": "debugpy",
      "request": "launch",
      "module": "sgw_platform.datagen.generate",
      "args": ["--out", "data"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "2 · W1 risk model  (~60s)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_w1.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "3 · W2 dispatch optimiser  (~30s)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_w2.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "4 · W4 condition monitoring  (~40s)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_w4.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "5 · Streamlit app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/main.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Extra · W2 sensitivity sweep  (~3min)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_w2_sensitivity.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Extra · Validate dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/validate_dataset.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug · Current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
