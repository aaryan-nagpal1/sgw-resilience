{
  // Use the project venv for running, debugging and IntelliSense.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Scripts use paths relative to the repo root (e.g. "data/", "artifacts/"),
  // so always run from the workspace folder rather than the file's directory.
  "python.terminal.executeInFileDir": false,

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    ".venv": true,
    "data": true,
    "artifacts": true
  }
}
